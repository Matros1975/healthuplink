# Copy to .env next to the public compose file and fill in. That file is compose.yaml in the published
# repository (receiver/compose.public.yaml in the source tree); it reads .env through `env_file`.

# The address on this machine that Docker publishes port 8796 on (never 0.0.0.0 unless you mean every network).
HU_PUBLISH_ADDR=
# The URL the phone uses to reach this receiver; `healthuplink pair` puts it in the pairing code.
HU_PUBLIC_URL=
# TLS: off, self-signed (the pairing code carries the certificate pin) or files (your own certificate).
HU_TLS=off
# Home time zone for the daily backup and prune (an IANA name such as Europe/Berlin).
HU_TZ=UTC
# Optional: a URL that gets a POST when uploads stop or the phone reports undelivered batches; empty for none.
HU_NOTIFY_WEBHOOK_URL=
# Body format of that POST.
HU_NOTIFY_FORMAT=json
# HU_TLS=files only: certificate chain and private key (PEM), inside the container (see the ./tls volume).
HU_TLS_CERT=
HU_TLS_KEY=
# HU_TLS=files only: false for a CA-signed certificate under a public name (no pin in the pairing code).
HU_TLS_PIN=true

# Example, Tailscale: the phone reaches the receiver on this machine's tailnet IP over plain http.
# HU_PUBLISH_ADDR=100.100.1.1
# HU_PUBLIC_URL=http://100.100.1.1:8796
# HU_TLS=off

# Example, home network with a self-signed certificate: use the machine's LAN IP or its .local name.
# HU_PUBLISH_ADDR=192.168.1.10
# HU_PUBLIC_URL=https://192.168.1.10:8796
# HU_TLS=self-signed
